1:[["$","$La",null,{"active":"practice"}],["$","main",null,{"id":"main-content","className":"study-workspace shell","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"현재 위치","children":[["$","a",null,{"href":"/hdat-ds-study-hub/practice/","children":"실전 연습"}],["$","span",null,{"children":"/ 필기"}]]}],["$","header",null,{"className":"workspace-heading","children":[["$","p",null,{"className":"micro-label","children":"필기 연습실"}],["$","h1",null,{"children":"풀고, 채점하고, 틀린 개념으로 돌아가기"}],["$","p",null,{"children":"기존 31강의 독자 60문항을 회차별로 응시합니다. 공식 기출과 공식 합격선은 제공하지 않습니다."}]]}],["$","$Lb",null,{"questions":[{"id":"written-1-1","round":1,"number":1,"prompt":"x의 shape가 (16, 20, 8)일 때 오류 없이 feature별 bias를 더하기 가장 적절한 bias shape는?","choices":["(16,)","(20,)","(8,)","(16,20)"],"answer":2,"explanation":"Broadcasting은 뒤축부터 맞춘다. feature 마지막 축 8에 bias (8,)가 맞는다.","lessonHref":"/learn/02/","lessonLabel":"2강 · Python·Jupyter·shape 언어","sourceHref":"/learn/31/#1-broadcasting"},{"id":"written-1-2","round":1,"number":2,"prompt":"다음 중 validation 누수를 일으키지 않는 것은?","choices":["split 전 전체 데이터로 StandardScaler fit","split 전 전체 데이터로 PCA fit","split 후 train fold로 median을 구해 valid에 적용","split 전 전체 데이터에 SMOTE 후 나누기"],"answer":2,"explanation":"train fold 통계만 valid에 적용하는 ③이 올바르다. 나머지는 validation 정보를 전처리 fit에 사용한다.","lessonHref":"/learn/08/","lessonLabel":"8강 · 전처리: 결측·이상치·스케일·인코딩·증강","sourceHref":"/learn/31/#2_1"},{"id":"written-1-3","round":1,"number":3,"prompt":"이진 node의 class 비율이 0.5/0.5에서 1.0/0.0으로 바뀔 때 entropy는?","choices":["0에서 최대로 증가","최대에서 0으로 감소","변하지 않음","음수가 됨"],"answer":1,"explanation":"50:50은 불확실성 최대, 순수 node는 entropy 0.","lessonHref":"/learn/06/","lessonLabel":"6강 · 확률·통계·정보이론","sourceHref":"/learn/31/#3"},{"id":"written-1-4","round":1,"number":4,"prompt":"800대 차량에서 차량당 여러 sensor 행이 있고 test에는 처음 보는 차량만 등장한다. 가장 적절한 validation은?","choices":["행 random split","stratified row split","vehicle group split","전체 train으로 학습 후 train score"],"answer":2,"explanation":"test가 새 차량이므로 vehicle-level group split이 배포 조건을 모사한다.","lessonHref":"/learn/13/","lessonLabel":"13강 · Validation Strategy와 데이터 누수","sourceHref":"/learn/31/#4-validation"},{"id":"written-1-5","round":1,"number":5,"prompt":"고장 class가 1%인 이진분류에서 소수 class 성능을 숨기지 않기 위한 첫 metric으로 가장 적절한 것은?","choices":["accuracy","Macro-F1","MSE","R²"],"answer":1,"explanation":"Macro-F1은 두 class F1을 동일 가중한다. accuracy는 전부 정상 예측도 99%.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#5-metric"},{"id":"written-1-6","round":1,"number":6,"prompt":"4-class 단일정답 분류에서 CrossEntropyLoss의 올바른 입력은?","choices":["sigmoid 확률 (B,1), float target (B,1)","softmax 확률 (B,4), one-hot target (B,4)만 가능","raw logits (B,4), long class index (B,)","raw logits (B,), long target (B,4)"],"answer":2,"explanation":"CE는 raw logits와 class index long target을 안정적으로 처리한다.","lessonHref":"/learn/17/","lessonLabel":"17강 · 퍼셉트론·MLP·활성함수·손실함수","sourceHref":"/learn/31/#6-loss"},{"id":"written-1-7","round":1,"number":7,"prompt":"pred=wx, L=(pred-y)², x=2,w=1,y=5일 때 dL/dw는?","choices":["-12","-6","6","12"],"answer":0,"explanation":"pred=2, error=-3. 2×error×x=2×(-3)×2=-12.","lessonHref":"/learn/05/","lessonLabel":"5강 · 미분·역전파·최적화의 원리","sourceHref":"/learn/31/#7"},{"id":"written-1-8","round":1,"number":8,"prompt":"Momentum의 핵심 설명으로 가장 적절한 것은?","choices":["gradient를 항상 0으로 만든다","과거 update 방향을 누적해 일관된 방향은 가속하고 진동을 줄인다","모든 parameter를 같은 상수로 바꾼다","validation loss를 직접 미분한다"],"answer":1,"explanation":"Momentum velocity가 과거 gradient 방향을 누적한다.","lessonHref":"/learn/05/","lessonLabel":"5강 · 미분·역전파·최적화의 원리","sourceHref":"/learn/31/#8-optimizer"},{"id":"written-1-9","round":1,"number":9,"prompt":"track_running_stats=True인 BatchNorm을 model.eval()로 평가할 때 옳은 것은?","choices":["현재 sample 하나의 통계만 사용","학습 중 저장한 running mean/variance 사용","모든 activation을 0으로 만듦","dropout 확률을 자동 선택"],"answer":1,"explanation":"eval mode BN은 training에서 누적한 running statistics를 쓴다.","lessonHref":"/learn/18/","lessonLabel":"18강 · PyTorch 학습 엔지니어링: optimizer·초기화·BN·Dropout","sourceHref":"/learn/31/#9-batch-normalization"},{"id":"written-1-10","round":1,"number":10,"prompt":"한 공간축 input 64, kernel 5, padding 2, stride 2, dilation 1인 convolution의 output 크기는?","choices":["30","31","32","64"],"answer":2,"explanation":"floor((64+4-4-1)/2+1)=32.","lessonHref":"/learn/19/","lessonLabel":"19강 · CNN: convolution·padding·pooling·이미지 코드","sourceHref":"/learn/31/#10-cnn"},{"id":"written-1-11","round":1,"number":11,"prompt":"Conv2d(3, 10, kernel_size=3, bias=True)의 parameter 수는?","choices":["270","280","300","input H/W에 따라 다름"],"answer":1,"explanation":"10×3×3×3+10=280.","lessonHref":"/learn/19/","lessonLabel":"19강 · CNN: convolution·padding·pooling·이미지 코드","sourceHref":"/learn/31/#11-cnn-parameter"},{"id":"written-1-12","round":1,"number":12,"prompt":"LSTM forget gate의 주 역할은?","choices":["class 확률 정규화","이전 cell state 유지 정도 조절","image downsampling","learning rate 감소"],"answer":1,"explanation":"forget gate가 c_{t-1}의 유지 비율을 조절한다.","lessonHref":"/learn/22/","lessonLabel":"22강 · RNN·LSTM·GRU와 1D CNN","sourceHref":"/learn/31/#12-lstm"},{"id":"written-1-13","round":1,"number":13,"prompt":"GRU(input_size=6, hidden_size=32, batch_first=True)에 (B=8,T=15,F=6)을 넣은 단방향 1층 sequence output shape는?","choices":["(8,32)","(15,8,32)","(8,15,32)","(8,15,6)"],"answer":2,"explanation":"batch_first sequence output은 [B,T,H]=[8,15,32].","lessonHref":"/learn/22/","lessonLabel":"22강 · RNN·LSTM·GRU와 1D CNN","sourceHref":"/learn/31/#13-rnn-shape"},{"id":"written-1-14","round":1,"number":14,"prompt":"Scaled dot-product attention에서 sqrt(d_k)로 나누는 주된 이유는?","choices":["sequence 길이를 줄이기 위해","score 규모가 dimension과 함께 커져 softmax가 포화하는 것을 완화","value를 one-hot으로 만들기 위해","positional encoding을 제거하기 위해"],"answer":1,"explanation":"내적 분산이 커져 softmax가 거의 one-hot으로 포화하는 것을 완화한다.","lessonHref":"/learn/23/","lessonLabel":"23강 · Attention과 Transformer","sourceHref":"/learn/31/#14-attention"},{"id":"written-1-15","round":1,"number":15,"prompt":"기본 self-attention에 positional information이 필요한 이유는?","choices":["attention은 channel을 처리할 수 없어서","attention만으로는 입력 순서를 명시적으로 알지 못해서","softmax 출력 합이 1이 아니어서","gradient를 계산할 수 없어서"],"answer":1,"explanation":"순서 표현을 별도로 넣어야 위치를 구분한다.","lessonHref":"/learn/23/","lessonLabel":"23강 · Attention과 Transformer","sourceHref":"/learn/31/#15-transformer"},{"id":"written-1-16","round":1,"number":16,"prompt":"Residual addition 전에 main branch와 shortcut의 shape가 다를 때 일반적인 해결은?","choices":["target을 one-hot 변환","1×1 projection과 필요한 stride 사용","sigmoid 추가","loss를 MAE로 변경"],"answer":1,"explanation":"1×1 convolution은 channel과 공간 stride를 맞춘다.","lessonHref":"/learn/20/","lessonLabel":"20강 · ResNet과 전이학습","sourceHref":"/learn/31/#16-resnet"},{"id":"written-1-17","round":1,"number":17,"prompt":"작은 새 이미지 데이터에서 pretrained model을 쓰는 일반적인 첫 단계는?","choices":["모든 weight 무작위 초기화","classifier head를 교체하고 backbone을 freeze해 head부터 학습","validation에도 random crop을 강제","target label을 input에 추가"],"answer":1,"explanation":"새 head부터 학습하면 작은 데이터에서 안정적이고 빠르다. 이후 일부 unfreeze.","lessonHref":"/learn/20/","lessonLabel":"20강 · ResNet과 전이학습","sourceHref":"/learn/31/#17_1"},{"id":"written-1-18","round":1,"number":18,"prompt":"정상 데이터로 학습한 AE의 일반적인 anomaly 판정은?","choices":["reconstruction error가 작을수록 anomaly","reconstruction error가 validation threshold보다 클수록 anomaly","latent dimension이 크면 모두 anomaly","train과 test error 평균이 같으면 anomaly"],"answer":1,"explanation":"일반 가정은 정상 reconstruction이 좋고 anomaly error가 크다는 것.","lessonHref":"/learn/24/","lessonLabel":"24강 · Autoencoder와 이상탐지","sourceHref":"/learn/31/#18-autoencoder"},{"id":"written-1-19","round":1,"number":19,"prompt":"VAE의 KL term 역할로 가장 적절한 것은?","choices":["output을 hard label로 변환","approximate posterior를 prior와 가깝게 규제","image 크기를 반으로 줄임","discriminator를 학습"],"answer":1,"explanation":"KL이 latent posterior를 prior 방향으로 regularize해 sampling 가능한 공간을 만든다.","lessonHref":"/learn/25/","lessonLabel":"25강 · VAE와 GAN","sourceHref":"/learn/31/#19-vae"},{"id":"written-1-20","round":1,"number":20,"prompt":"BCEWithLogitsLoss를 사용하는 Discriminator의 마지막 layer로 가장 적절한 것은?","choices":["Linear로 logit 1개, sigmoid 없음","Linear 뒤 softmax class 10개","ReLU만 사용, 출력 없음","sigmoid를 두 번 적용"],"answer":0,"explanation":"loss가 sigmoid까지 포함하므로 D는 raw logit 하나를 반환한다.","lessonHref":"/learn/25/","lessonLabel":"25강 · VAE와 GAN","sourceHref":"/learn/31/#20-gan"},{"id":"written-2-1","round":2,"number":1,"prompt":"명시적 target 없이 데이터 구조를 찾는 학습은?","choices":["지도","비지도","강화","회귀만"],"answer":1,"explanation":"비지도는 target 없이 구조를 찾는다.","lessonHref":"/learn/01/","lessonLabel":"1강 · 시험 지도를 먼저 그리기","sourceHref":"/learn/31/#2-1"},{"id":"written-2-2","round":2,"number":2,"prompt":"validation fold의 중앙값을 imputation에 사용하지 않게 하는 가장 안전한 구조는?","choices":["전체 fit 후 split","fold 내부 Pipeline","test 평균 사용","결측 행 전부 무조건 삭제"],"answer":1,"explanation":"Pipeline이 fold별 fit을 보장한다.","lessonHref":"/learn/08/","lessonLabel":"8강 · 전처리: 결측·이상치·스케일·인코딩·증강","sourceHref":"/learn/31/#2-2"},{"id":"written-2-3","round":2,"number":3,"prompt":"일반적인 결정트리에 feature standardization이 필수가 아닌 이유는?","choices":["gradient가 없어서가 아니라 threshold 순서 분할이 단조 scale에 거의 불변","결측이 자동 제거","모든 tree가 선형","target을 사용하지 않음"],"answer":0,"explanation":"tree는 단조변환 후 순서를 유지한다.","lessonHref":"/learn/11/","lessonLabel":"11강 · 결정트리·앙상블·SVM","sourceHref":"/learn/31/#2-3"},{"id":"written-2-4","round":2,"number":4,"prompt":"Ridge의 λ를 매우 크게 하면 일반적으로?","choices":["weight 크기 감소·bias 증가","weight 폭발","L1 sparsity만 발생","test label 사용"],"answer":0,"explanation":"L2가 weight를 수축시켜 underfit할 수 있다.","lessonHref":"/learn/10/","lessonLabel":"10강 · 선형회귀·로지스틱회귀·KNN","sourceHref":"/learn/31/#2-4"},{"id":"written-2-5","round":2,"number":5,"prompt":"이진 logistic logit이 ln(3)이면 odds와 확률은?","choices":["odds 3, p=0.75","odds 0.75, p=3","odds 1, p=.5","odds 3, p=.25"],"answer":0,"explanation":"odds=e^logit=3, p=3/(1+3).","lessonHref":"/learn/10/","lessonLabel":"10강 · 선형회귀·로지스틱회귀·KNN","sourceHref":"/learn/31/#2-5"},{"id":"written-2-6","round":2,"number":6,"prompt":"KNN의 k를 1에서 매우 크게 늘릴 때 일반적 변화는?","choices":["variance↑ bias↓","variance↓ bias↑","둘 다 반드시 0","scale 영향 소멸"],"answer":1,"explanation":"k 증가는 smoothing이다.","lessonHref":"/learn/10/","lessonLabel":"10강 · 선형회귀·로지스틱회귀·KNN","sourceHref":"/learn/31/#2-6"},{"id":"written-2-7","round":2,"number":7,"prompt":"RBF SVM에서 C와 gamma가 모두 지나치게 크면?","choices":["매우 단순한 경계만 가능","복잡하고 국소적인 경계로 overfit 위험","선형회귀가 됨","PCA가 자동 실행"],"answer":1,"explanation":"큰 C/gamma는 복잡도를 높인다.","lessonHref":"/learn/11/","lessonLabel":"11강 · 결정트리·앙상블·SVM","sourceHref":"/learn/31/#2-7"},{"id":"written-2-8","round":2,"number":8,"prompt":"class 비율 0.8/0.2인 node의 Gini는?","choices":[".16",".32",".50",".64"],"answer":1,"explanation":"1-(.64+.04)=.32.","lessonHref":"/learn/11/","lessonLabel":"11강 · 결정트리·앙상블·SVM","sourceHref":"/learn/31/#2-8"},{"id":"written-2-9","round":2,"number":9,"prompt":"Random Forest의 핵심은?","choices":["boosting만 사용","bootstrap과 feature 무작위성으로 덜 상관된 tree를 평균","하나의 매우 깊은 tree","거리 기반 voting"],"answer":1,"explanation":"RF는 bagging 계열이다.","lessonHref":"/learn/11/","lessonLabel":"11강 · 결정트리·앙상블·SVM","sourceHref":"/learn/31/#2-9"},{"id":"written-2-10","round":2,"number":10,"prompt":"Gradient boosting 설명으로 옳은 것은?","choices":["모든 tree 독립 병렬만","앞 모델 residual/negative gradient를 순차 보완","label 없이 centroid 갱신","margin만 최대화"],"answer":1,"explanation":"boosting은 순차 보완이다.","lessonHref":"/learn/11/","lessonLabel":"11강 · 결정트리·앙상블·SVM","sourceHref":"/learn/31/#2-10"},{"id":"written-2-11","round":2,"number":11,"prompt":"L1 coefficient가 0이 된 feature를 제거하는 방식은?","choices":["wrapper만","embedded selection","PCA extraction","clustering"],"answer":1,"explanation":"학습 모델 내부의 L1 선택이다.","lessonHref":"/learn/09/","lessonLabel":"9강 · Feature Engineering·Selection·Extraction","sourceHref":"/learn/31/#2-11"},{"id":"written-2-12","round":2,"number":12,"prompt":"PCA에 대한 옳은 설명은?","choices":["target class 분리만 최대화","X 분산이 큰 직교 방향을 찾는 비지도 extraction","원 feature 일부만 선택","scale과 무관"],"answer":1,"explanation":"PCA는 target 비사용.","lessonHref":"/learn/09/","lessonLabel":"9강 · Feature Engineering·Selection·Extraction","sourceHref":"/learn/31/#2-12"},{"id":"written-2-13","round":2,"number":13,"prompt":"입력 feature가 8개인 5-class LDA가 만들 수 있는 discriminant 축의 최대 수는?","choices":["2","4","5","feature 수와 무관하게 10"],"answer":1,"explanation":"min(F,C-1)=min(8,4)=4.","lessonHref":"/learn/09/","lessonLabel":"9강 · Feature Engineering·Selection·Extraction","sourceHref":"/learn/31/#2-13"},{"id":"written-2-14","round":2,"number":14,"prompt":"K-means의 centroid 갱신은?","choices":["cluster 내 점의 평균","가장 먼 점","target 평균","support vector"],"answer":0,"explanation":"할당된 점 평균.","lessonHref":"/learn/12/","lessonLabel":"12강 · 군집화·DBSCAN·PCA와 비지도학습","sourceHref":"/learn/31/#2-14"},{"id":"written-2-15","round":2,"number":15,"prompt":"DBSCAN의 장점은?","choices":["cluster 수 k가 반드시 필요","임의 형태 cluster와 noise 식별 가능","고차원에서 항상 완벽","scale이 전혀 무관"],"answer":1,"explanation":"density 연결과 noise가 장점.","lessonHref":"/learn/12/","lessonLabel":"12강 · 군집화·DBSCAN·PCA와 비지도학습","sourceHref":"/learn/31/#2-15"},{"id":"written-2-16","round":2,"number":16,"prompt":"불균형 single-label classification에서 fold별 class 비율을 유지하려면?","choices":["KFold","StratifiedKFold","GroupKFold만","PCA"],"answer":1,"explanation":"stratification.","lessonHref":"/learn/13/","lessonLabel":"13강 · Validation Strategy와 데이터 누수","sourceHref":"/learn/31/#2-16"},{"id":"written-2-17","round":2,"number":17,"prompt":"Target encoding의 가장 큰 위험은?","choices":["feature 수 감소","자기 행/validation target 통계가 들어가는 누수","숫자가 됨","category가 존재함"],"answer":1,"explanation":"out-of-fold가 필요한 이유다.","lessonHref":"/learn/09/","lessonLabel":"9강 · Feature Engineering·Selection·Extraction","sourceHref":"/learn/31/#2-17"},{"id":"written-2-18","round":2,"number":18,"prompt":"큰 오차에 제곱 penalty를 주면서 target 원 단위로 해석되는 metric은?","choices":["RMSE","MAE","accuracy","entropy"],"answer":0,"explanation":"RMSE.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#2-18"},{"id":"written-2-19","round":2,"number":19,"prompt":"탐색 차원이 많고 평가 횟수가 제한될 때 Grid보다 자주 효율적인 것은?","choices":["RandomizedSearch","test 수동 선택","모든 조합 무한 반복","validation 삭제"],"answer":0,"explanation":"Random search가 중요한 차원을 넓게 탐색한다.","lessonHref":"/learn/15/","lessonLabel":"15강 · Regularization·Hyperparameter Tuning·실험 설계","sourceHref":"/learn/31/#2-19"},{"id":"written-2-20","round":2,"number":20,"prompt":"SMOTE의 올바른 적용 위치는?","choices":["split 전 전체 데이터","각 train fold 내부","validation+test","제출 후"],"answer":1,"explanation":"resampling은 train fold에만 적용한다.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#2-20"},{"id":"written-3-1","round":3,"number":1,"prompt":"모집단 [0,2,4]의 평균과 분산은?","choices":["2, 8/3","2, 4","3, 8/3","2, sqrt(8/3)"],"answer":0,"explanation":"편차 제곱합 8을 3으로 나눈다.","lessonHref":"/learn/06/","lessonLabel":"6강 · 확률·통계·정보이론","sourceHref":"/learn/31/#3-1"},{"id":"written-3-2","round":3,"number":2,"prompt":"고장률 10%, 고장일 때 경보 80%, 정상일 때 오경보 20%라면 경보가 울렸을 때 실제 고장 확률은?","choices":["8%","20%","약 30.8%","80%"],"answer":2,"explanation":"0.08/(0.08+0.18)=.3077.","lessonHref":"/learn/06/","lessonLabel":"6강 · 확률·통계·정보이론","sourceHref":"/learn/31/#3-2"},{"id":"written-3-3","round":3,"number":3,"prompt":"Linear(12,5)의 parameter와 batch 7 output은?","choices":["60개, (7,5)","65개, (7,5)","65개, (5,7)","17개, (7,12)"],"answer":1,"explanation":"12×5+5=65.","lessonHref":"/learn/04/","lessonLabel":"4강 · 선형대수: 모델의 shape를 계산하는 언어","sourceHref":"/learn/31/#3-3"},{"id":"written-3-4","round":3,"number":4,"prompt":"활성함수 그래프가 원점을 지나고 홀함수이며, 출력 범위가 (-1,1)이고 양 끝에서 포화한다. 이 함수는?","choices":["sigmoid","tanh","ReLU","softmax"],"answer":1,"explanation":"tanh는 원점 대칭 S자이고 범위가 (-1,1)이다.","lessonHref":"/learn/17/","lessonLabel":"17강 · 퍼셉트론·MLP·활성함수·손실함수","sourceHref":"/learn/31/#3-4"},{"id":"written-3-5","round":3,"number":5,"prompt":"실제 [1,3], 예측 [2,5]의 MSE/RMSE는?","choices":["1.5/sqrt1.5","2.5/sqrt2.5","5/2","3/1.5"],"answer":1,"explanation":"squared error 1,4 평균 2.5.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#3-5"},{"id":"written-3-6","round":3,"number":6,"prompt":"TP=40, FP=10, FN=40일 때 precision/recall/F1은?","choices":[".8/.5 약 .615",".5/.8 약 .615",".8/.8 .8",".4/.5 .444"],"answer":0,"explanation":"P=.8,R=.5,F1≈.615.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#3-6"},{"id":"written-3-7","round":3,"number":7,"prompt":"RMSLE에 직접 넣을 수 없는 일반적인 target/prediction은?","choices":["0","양수","음수","1"],"answer":2,"explanation":"이 문항의 RMSLE는 비음수 target·prediction을 요구한다. log1p 자체는 -1보다 큰 음수에서도 정의되므로 metric의 입력 규약과 구분한다.","lessonHref":"/learn/14/","lessonLabel":"14강 · 평가지표와 불균형","sourceHref":"/learn/31/#3-7"},{"id":"written-3-8","round":3,"number":8,"prompt":"이미지 분류의 data augmentation 적용으로 가장 올바른 것은?","choices":["train/valid/test 모두 random crop·flip","train에만 label-preserving random 변환, valid/test에는 deterministic resize·normalize","valid에만 강한 random 변환","test label을 보고 변환 선택"],"answer":1,"explanation":"augmentation은 train에만 stochastic하게 적용하고 평가 분포는 deterministic하게 고정한다.","lessonHref":"/learn/08/","lessonLabel":"8강 · 전처리: 결측·이상치·스케일·인코딩·증강","sourceHref":"/learn/31/#3-8"},{"id":"written-3-9","round":3,"number":9,"prompt":"MaxPool2d(2,2)가 (B,16,32,40)에 적용된 output은?","choices":["(B,16,16,20)","(B,8,16,20)","(B,16,32,40)","(B,32,16,20)"],"answer":0,"explanation":"공간축 절반.","lessonHref":"/learn/19/","lessonLabel":"19강 · CNN: convolution·padding·pooling·이미지 코드","sourceHref":"/learn/31/#3-9"},{"id":"written-3-10","round":3,"number":10,"prompt":"BatchNorm1d(20)의 learnable γ,β parameter 수는?","choices":["20","40","60","batch size에 따라 변함"],"answer":1,"explanation":"γ/β 각","lessonHref":"/learn/18/","lessonLabel":"18강 · PyTorch 학습 엔지니어링: optimizer·초기화·BN·Dropout","sourceHref":"/learn/31/#3-10"},{"id":"written-3-11","round":3,"number":11,"prompt":"LSTM cell update로 옳은 것은?","choices":["c_t=f_t⊙c_{t-1}+i_t⊙g_t","c_t=softmax(x)","c_t=QKᵀ","c_t=maxpool(x)"],"answer":0,"explanation":"11. additive cell path.","lessonHref":"/learn/22/","lessonLabel":"22강 · RNN·LSTM·GRU와 1D CNN","sourceHref":"/learn/31/#3-11"},{"id":"written-3-12","round":3,"number":12,"prompt":"길이 T=500, lookback=20, horizon=30, stride 1의 window 수는?","choices":["450","451","470","500"],"answer":1,"explanation":"500-20-30+1=451.","lessonHref":"/learn/21/","lessonLabel":"21강 · 시계열 데이터 계약과 window","sourceHref":"/learn/31/#3-12"},{"id":"written-3-13","round":3,"number":13,"prompt":"target index가 cut 이상이면 validation에 배정하는 규칙에서 cut=400이고 window target index가 400, input 마지막 index가 370일 때 time validation 배정은?","choices":["train","valid","폐기만 가능","random"],"answer":1,"explanation":"target index로 valid.","lessonHref":"/learn/13/","lessonLabel":"13강 · Validation Strategy와 데이터 누수","sourceHref":"/learn/31/#3-13"},{"id":"written-3-14","round":3,"number":14,"prompt":"한 query score가 [0, ln3]이면 softmax weight는?","choices":["[.5,.5]","[.25,.75]","[.75,.25]","[0,1]"],"answer":1,"explanation":"exp 비율 1:3.","lessonHref":"/learn/23/","lessonLabel":"23강 · Attention과 Transformer","sourceHref":"/learn/31/#3-14"},{"id":"written-3-15","round":3,"number":15,"prompt":"VAE에서 mu=0, logvar=0인 1차원 posterior와 N(0,1) prior의 KL은?","choices":["0",".5","1","무한대"],"answer":0,"explanation":"posterior=prior.","lessonHref":"/learn/25/","lessonLabel":"25강 · VAE와 GAN","sourceHref":"/learn/31/#3-15"},{"id":"written-3-16","round":3,"number":16,"prompt":"AE validation 정상 error의 99 percentile을 threshold로 썼다. score가 threshold보다 큰 sample의 일반적 label은?","choices":["정상","anomaly","class 99","알 수 없어 항상 삭제"],"answer":1,"explanation":"일반 판정 anomaly.","lessonHref":"/learn/24/","lessonLabel":"24강 · Autoencoder와 이상탐지","sourceHref":"/learn/31/#3-16"},{"id":"written-3-17","round":3,"number":17,"prompt":"GAN discriminator step에서 G(z).detach()의 목적은?","choices":["G gradient graph 차단","D gradient 차단","sigmoid 두 번","noise 제거"],"answer":0,"explanation":"D만 학습.","lessonHref":"/learn/25/","lessonLabel":"25강 · VAE와 GAN","sourceHref":"/learn/31/#3-17"},{"id":"written-3-18","round":3,"number":18,"prompt":"Residual main output (B,64,16,16), input (B,32,32,32)일 때 shortcut은?","choices":["identity","1×1, stride2, 32→64","maxpool만","softmax"],"answer":1,"explanation":"channel·공간 projection.","lessonHref":"/learn/20/","lessonLabel":"20강 · ResNet과 전이학습","sourceHref":"/learn/31/#3-18"},{"id":"written-3-19","round":3,"number":19,"prompt":"multilabel 5개 target의 올바른 계약은?","choices":["logits (B,5), float target (B,5), BCEWithLogits","logits (B,5), long target (B,), CE","logits (B,1), target (B,5)","argmax만"],"answer":0,"explanation":"각 label 독립 binary.","lessonHref":"/learn/17/","lessonLabel":"17강 · 퍼셉트론·MLP·활성함수·손실함수","sourceHref":"/learn/31/#3-19"},{"id":"written-3-20","round":3,"number":20,"prompt":"문제가 정확히 (8333,3) NPY를 요구할 때 (8333,)이 나온 모델의 올바른 대응은?","choices":["파일명만 변경","3개 output을 내도록 모델/예측 계약 수정","같은 배열 세 번 저장하지 않고 무조건 제출","flatten"],"answer":1,"explanation":"shape를 억지 reshape하지 말고 output 의미부터 수정한다.","lessonHref":"/learn/30/","lessonLabel":"30강 · 제출·디버깅·170분 운영","sourceHref":"/learn/31/#3-20"}]}]]}],"$Lc"]
c:["$","footer",null,{"className":"site-footer","children":[["$","div",null,{"className":"shell footer-grid","children":[["$","div",null,{"children":[["$","strong",null,{"children":"HDAT DS · PyTorch Study Room"}],["$","p",null,{"children":"Python이라는 이름만 아는 사람도 데이터 분석부터 순서대로 완주하도록 만든 개인 학습 자료입니다."}]]}],["$","nav",null,{"aria-label":"하단 메뉴","children":[["$","a",null,{"href":"/hdat-ds-study-hub/start/","children":"Python 기초 10강"}],["$","a",null,{"href":"/hdat-ds-study-hub/learn/","children":"HDAT 본과정 34강"}],["$","a",null,{"href":"/hdat-ds-study-hub/practice/","children":"실전 연습"}],["$","a",null,{"href":"/hdat-ds-study-hub/resources/","children":"자료실"}],["$","a",null,{"href":"/hdat-ds-study-hub/cheatsheet.html","children":"로컬 치트시트"}]]}]]}],["$","p",null,{"className":"legal shell","children":"이 사이트는 개인 학습용 비공식 자료이며 현대자동차그룹 또는 현대엔지비의 공식 사이트가 아닙니다. 시험 당일 문제 지시, 제공 스켈레톤, 공식 규정과 감독관 안내가 항상 우선합니다."}]]}]
