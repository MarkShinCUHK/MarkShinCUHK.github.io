1:[["$","$La",null,{"active":"practice"}],["$","main",null,{"id":"main-content","className":"coding-practice shell","children":[["$","header",null,{"className":"section-heading","children":[["$","p",null,{"className":"eyebrow","children":"읽기에서 직접 쓰기로 · 독자 입문 문제"}],["$","h1",null,{"children":"10분 코딩 연습"}],["$","p",null,{"children":"한 번에 한 문제면 충분합니다. Jupyter의 새 노트북에서 시작하세요. 이 페이지는 Python을 실행하지 않으며, 입력 코드를 외부로 보내지 않습니다."}]]}],["$","ol",null,{"className":"coding-instructions","children":[["$","li",null,{"children":"문제의 입력·출력 조건을 읽고 예상 결과를 적습니다."}],["$","li",null,{"children":"시작 코드를 새 셀에 붙여 넣고 TODO를 구현합니다."}],["$","li",null,{"children":"검사 코드를 다음 셀에서 실행합니다. 실패하면 마지막 오류 줄부터 확인합니다."}],["$","li",null,{"children":"막혔을 때 힌트, 그다음 해설 순서로 엽니다. 다음 날에는 힌트 없이 다시 풉니다."}]]}],["$","p",null,{"children":["$","a",null,{"className":"button button-secondary","href":"/hdat-ds-study-hub/downloads/ten-minute-coding.py","download":true,"children":"문제·검사 코드 다운로드 ↓"}]}],["$","nav",null,{"className":"coding-jump","aria-label":"코딩 문제 선택","children":[["$","a","python-filter",{"href":"#python-filter","children":[1,". ","조건에 맞는 값만 반환하기"]}],["$","a","numpy-center",{"href":"#numpy-center","children":[2,". ","각 열의 평균을 빼기"]}],["$","a","pandas-tensor",{"href":"#pandas-tensor","children":[3,". ","표를 모델 입력으로 바꾸기"]}]]}],[["$","article","python-filter",{"className":"coding-task lesson-content","id":"python-filter","children":[["$","p",null,{"className":"micro-label","children":["문제 ",1," · 권장 ",10,"분 · 제한시간 아님"]}],["$","h2",null,{"children":"조건에 맞는 값만 반환하기"}],["$","p",null,{"children":"점수 리스트에서 기준 이상인 점수만 원래 순서대로 반환하세요. 원본 리스트를 바꾸지 마세요. 빈 입력에는 빈 리스트를 반환합니다."}],["$","p",null,{"children":["$","a",null,{"href":"/hdat-ds-study-hub/start/04/","children":["먼저 배우기: ","기초 4강 · 조건문·반복문·함수"," →"]}]}],["$","h3",null,{"children":"시작 코드"}],["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"def select_scores(scores, minimum):\n    # TODO: 새 리스트를 만들어 반환하세요.\n    pass"}]}],["$","details",null,{"children":[["$","summary",null,{"children":"힌트만 보기"}],["$","p",null,{"children":"빈 리스트 result를 만들고 for로 점수를 하나씩 확인하세요. score >= minimum일 때 append하고, 반복문 밖에서 return합니다."}]]}],["$","h3",null,{"children":"검사 코드"}],["$","p",null,{"children":[["$","code",null,{"children":"assert"}],"는 조건이 참인지 확인합니다. 거짓이면 ",["$","code",null,{"children":"AssertionError"}],"가 납니다. 처음 TODO 그대로 실행하면 실패하는 것이 정상입니다."]}],["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"original = [50, 70, 90, 70]\nassert select_scores(original, 70) == [70, 90, 70]\nassert select_scores([], 70) == []\nassert select_scores([69, 70], 70) == [70]\nassert original == [50, 70, 90, 70]\nprint('통과: 경계값·빈 입력·원본 보존')"}]}],["$","details",null,{"className":"answer-panel","children":[["$","summary",null,{"children":"직접 시도한 뒤 정답·해설 보기"}],["$","div",null,{"className":"answer-body","children":[["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"def select_scores(scores, minimum):\n    result = []\n    for score in scores:\n        if score >= minimum:\n            result.append(score)\n    return result"}]}],["$","p",null,{"children":">= 대신 >를 쓰면 기준과 같은 점수가 빠집니다. return을 for 안에 쓰면 첫 번째 반복에서 함수가 끝납니다."}],["$","p",null,{"children":"검사를 통과한 뒤 숫자를 바꾸어 다시 예상해 보세요. 검사 통과는 이 문제의 조건을 확인한 것이지 모든 가능한 입력을 보장하지는 않습니다."}]]}]]}]]}],["$","article","numpy-center",{"className":"coding-task lesson-content","id":"numpy-center","children":[["$","p",null,{"className":"micro-label","children":["문제 ",2," · 권장 ",10,"분 · 제한시간 아님"]}],["$","h2",null,{"children":"각 열의 평균을 빼기"}],["$","p",null,{"children":"2차원 수치 배열을 받아 각 열의 평균을 뺀 배열을 반환하세요. 입력과 shape가 같아야 하고 원본을 수정하면 안 됩니다. 이번 문제는 비어 있지 않은 2차원 배열만 입력됩니다."}],["$","p",null,{"children":["$","a",null,{"href":"/hdat-ds-study-hub/start/06/","children":["먼저 배우기: ","기초 6강 · axis·broadcasting"," →"]}]}],["$","h3",null,{"children":"시작 코드"}],["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"import numpy as np\n\ndef center_columns(values):\n    # TODO: 열별 평균을 구하고 빼세요.\n    pass"}]}],["$","details",null,{"children":[["$","summary",null,{"children":"힌트만 보기"}],["$","p",null,{"children":"열마다 하나의 평균을 남기려면 행 방향인 axis=0으로 mean을 구합니다. (행, 열) 배열에서 (1, 열)을 빼면 각 행에 같은 열 평균이 적용됩니다."}]]}],["$","h3",null,{"children":"검사 코드"}],["$","p",null,{"children":[["$","code",null,{"children":"assert"}],"는 조건이 참인지 확인합니다. 거짓이면 ",["$","code",null,{"children":"AssertionError"}],"가 납니다. 처음 TODO 그대로 실행하면 실패하는 것이 정상입니다."]}],"$Lb","$Lc"]}],"$Ld"],"$Le"]}],"$Lf"]
b:["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"values = np.array([[1., 10.], [3., 30.], [5., 50.]], dtype=np.float32)\nbefore = values.copy()\nresult = center_columns(values)\nassert isinstance(result, np.ndarray)\nassert result.shape == (3, 2)\nnp.testing.assert_allclose(result, [[-2., -20.], [0., 0.], [2., 20.]])\nnp.testing.assert_allclose(result.mean(axis=0), [0., 0.], atol=1e-6)\nnp.testing.assert_array_equal(values, before)\nnp.testing.assert_allclose(center_columns(np.array([[2., 8.]])), [[0., 0.]])\nprint('통과: 열별 계산·shape·단일 행·원본 보존')"}]}]
c:["$","details",null,{"className":"answer-panel","children":[["$","summary",null,{"children":"직접 시도한 뒤 정답·해설 보기"}],["$","div",null,{"className":"answer-body","children":[["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"import numpy as np\n\ndef center_columns(values):\n    means = values.mean(axis=0, keepdims=True)\n    return values - means"}]}],["$","p",null,{"children":"axis=1은 행별 평균이므로 다른 문제를 풉니다. 부동소수점은 ==보다 허용 오차를 두는 allclose로 검사합니다. 이 함수는 NumPy 축 연습이며, 모델링에서는 train에서만 구한 평균을 valid/test에 재사용해야 합니다."}],["$","p",null,{"children":"검사를 통과한 뒤 숫자를 바꾸어 다시 예상해 보세요. 검사 통과는 이 문제의 조건을 확인한 것이지 모든 가능한 입력을 보장하지는 않습니다."}]]}]]}]
d:["$","article","pandas-tensor",{"className":"coding-task lesson-content","id":"pandas-tensor","children":[["$","p",null,{"className":"micro-label","children":["문제 ",3," · 권장 ",15,"분 · 제한시간 아님"]}],["$","h2",null,{"children":"표를 모델 입력으로 바꾸기"}],["$","p",null,{"children":"speed가 50 이상인 행만 고르고 ['temperature', 'speed'] 순서로 float32 CPU Tensor를 반환하세요. 해당 열은 결측치 없는 숫자라고 가정합니다. 행 순서와 원본 표를 보존하며, 조건에 맞는 행이 없으면 shape (0, 2)여야 합니다."}],["$","p",null,{"children":["$","a",null,{"href":"/hdat-ds-study-hub/start/10/","children":["먼저 배우기: ","기초 7·10강 · 열 선택·Tensor"," →"]}]}],["$","h3",null,{"children":"시작 코드"}],["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"import numpy as np\nimport pandas as pd\nimport torch\n\ndef make_features(frame):\n    # TODO: 행 선택 → 열 순서 고정 → NumPy → Tensor\n    pass"}]}],["$","details",null,{"children":[["$","summary",null,{"children":"힌트만 보기"}],["$","p",null,{"children":"frame.loc[행 조건, 열 이름 리스트]로 두 가지를 함께 선택할 수 있습니다. to_numpy(dtype=np.float32, copy=True) 후 torch.from_numpy를 쓰세요."}]]}],["$","h3",null,{"children":"검사 코드"}],["$","p",null,{"children":[["$","code",null,{"children":"assert"}],"는 조건이 참인지 확인합니다. 거짓이면 ",["$","code",null,{"children":"AssertionError"}],"가 납니다. 처음 TODO 그대로 실행하면 실패하는 것이 정상입니다."]}],["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"frame = pd.DataFrame({'speed': [40, 50, 70], 'temperature': [20, 22, 30]}, index=[9, 3, 8])\nbefore = frame.copy(deep=True)\nresult = make_features(frame)\nassert isinstance(result, torch.Tensor)\nassert result.shape == (2, 2)\nassert result.dtype == torch.float32 and result.device.type == 'cpu'\ntorch.testing.assert_close(result, torch.tensor([[22., 50.], [30., 70.]]))\nassert torch.isfinite(result).all()\nassert make_features(frame.iloc[:1]).shape == (0, 2)\npd.testing.assert_frame_equal(frame, before)\nprint('통과: 조건·열 순서·shape·dtype·원본 보존')"}]}],["$","details",null,{"className":"answer-panel","children":[["$","summary",null,{"children":"직접 시도한 뒤 정답·해설 보기"}],["$","div",null,{"className":"answer-body","children":[["$","pre",null,{"tabIndex":0,"children":["$","code",null,{"children":"import numpy as np\nimport pandas as pd\nimport torch\n\ndef make_features(frame):\n    selected = frame.loc[frame['speed'] >= 50, ['temperature', 'speed']]\n    array = selected.to_numpy(dtype=np.float32, copy=True)\n    return torch.from_numpy(array)"}]}],["$","p",null,{"children":"행을 거른 뒤 index는 [3, 8]이어도 괜찮습니다. Tensor에서는 선택된 행 순서가 유지됩니다. speed부터 변환하면 shape는 같아도 모델이 받는 특성 의미가 달라집니다."}],["$","p",null,{"children":"검사를 통과한 뒤 숫자를 바꾸어 다시 예상해 보세요. 검사 통과는 이 문제의 조건을 확인한 것이지 모든 가능한 입력을 보장하지는 않습니다."}]]}]]}]]}]
