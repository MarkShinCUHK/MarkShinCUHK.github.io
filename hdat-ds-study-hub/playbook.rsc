1:[["$","$La",null,{"active":"playbook"}],["$","main",null,{"id":"main-content","className":"shell playbook-index","children":[["$","header",null,{"className":"playbook-heading","children":[["$","p",null,{"className":"micro-label","children":"OPEN BOOK · PYTORCH · ASTRA REVIEW"}],["$","h1",null,{"children":["이 문제, 어느 코드부터",["$","br",null,{}],"고치면 될까요?"]}],["$","p",null,{"children":"Process 5유형 + Problem 7유형. 문제 신호를 고르면 입력·정답 shape, 바꿀 인수, 실행 코드와 검증 기준으로 이어집니다."}],["$","div",null,{"className":"playbook-actions","children":[["$","a",null,{"className":"button button-primary","href":"/hdat-ds-study-hub/playbook/00/","children":"처음이면 사용법부터 →"}],["$","a",null,{"className":"button button-light","href":"/hdat-ds-study-hub/cheatsheet.html","children":"전체 코드 치트시트 ↗"}]]}],["$","p",null,{"className":"playbook-note","children":"개인 학습용 비공식 자료 · 2026-09-07 감사 반영. 파일 반입·사이트 사용은 해당 회차 규정이 우선하며 생성형 AI 활용은 공식 안내상 금지입니다."}]]}],["$","nav",null,{"className":"playbook-quick","aria-label":"실기 빠른 이동","children":[["$","a",null,{"href":"#process","children":"함수·구조 구현 01–05 ↓"}],["$","a",null,{"href":"#problem","children":"전체 예측 풀이 06–12 ↓"}],["$","a",null,{"href":"/hdat-ds-study-hub/playbook/13/","children":"제출·오류 복구 →"}],["$","a",null,{"href":"/hdat-ds-study-hub/playbook/14/","children":"고급 구조·지원 경계 →"}],["$","a",null,{"href":"/hdat-ds-study-hub/practice/labs/","children":"실전 15문제 + 사용 매뉴얼 →"}]]}],[["$","section","Process",{"className":"playbook-group","id":"process","children":[["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"micro-label","children":"PROCESS"}],["$","h2",null,{"children":"정해진 동작을 정확히 구현하기"}],["$","p",null,{"children":"함수명·입출력·경계조건이 우선입니다. 비슷한 코드가 아니라 명세에 맞는 코드를 고르세요."}]]}],["$","div",null,{"className":"playbook-grid","children":[["$","a","01",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/01/","children":[["$","span",null,{"className":"playbook-number","children":"01"}],["$","h3",null,{"children":"선택 열 변환·결측·이상치"}],["$","p",null,{"children":"“지정 열만 0~1”, “중앙값과 IQR”, “clip/제거/flag”가 보이면 모델을 학습하는 문제가 아니라 DataFrame 계약을 구현하는 문제입니다. Min-Max는 minmax_selected; clipping은 fit_iqr_bounds와 apply_clip_bounds를 사용합니다. clip은 값을 경계로 자르고, remove는 행을 지우고, flag는 표시 열을 만드는 것이므로 서로 대체할 수 없습니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","02",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/02/","children":[["$","span",null,{"className":"playbook-number","children":"02"}],["$","h3",null,{"children":"group별 lag·rolling·시간 파생"}],["$","p",null,{"children":"“각 차량별 이전 n개 평균”, “현재 행 제외”, “원래 행 순서 유지”는 정렬 → group → shift → rolling → 원순서 복원입니다. 날짜의 연/월/요일만 필요하면 소스 add_datetime_features; 과거 평균은 32강의 add_past_mean을 선택합니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","03",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/03/","children":[["$","span",null,{"className":"playbook-number","children":"03"}],["$","h3",null,{"children":"NumPy 수치 함수·평가 지표"}],["$","p",null,{"children":"“NumPy만 사용”, “logits를 받아 평균 CE 반환”, “F1 직접 구현”이면 라이브러리 호출로 대체하지 말고 수식을 구현합니다. 26강 stable_softmax와 32강 numpy_cross_entropy가 시작점입니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","04",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/04/","children":[["$","span",null,{"className":"playbook-number","children":"04"}],["$","h3",null,{"children":"crop·channel·이미지 정규화"}],["$","p",null,{"children":"“PIL crop”, “원 mode 유지”, “uint8 HWC를 float32 CHW로”를 구분합니다. 영역 자르기는 crop_to_numpy(image, box). batch 배열을 PyTorch로 바꾸는 것은 prepare_numpy_images(X, layout, divide_255)입니다. 중앙 crop 함수는 32강 center_crop_array에 있습니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","05",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/05/","children":[["$","span",null,{"className":"playbook-number","children":"05"}],["$","h3",null,{"children":"지정 모델 구조·Conv 출력 계산"}],["$","p",null,{"children":"“다음 순서로 레이어 구성”, “마지막 시점의 LSTM 출력”, “parameter 수 반환”이면 정확한 명세 구현입니다. 범용 MLP/CNN을 가져와 비슷하게 만드는 문제가 아닙니다. 26강 SpecCNN, 32강 ExamMLP·ExamLSTM·conv2d_info를 선택하세요."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}]]}]]}],["$","section","Problem",{"className":"playbook-group","id":"problem","children":["$Lb","$Lc"]}]],"$Ld","$Le"]}],"$Lf"]
b:["$","div",null,{"className":"section-heading","children":[["$","p",null,{"className":"micro-label","children":"PROBLEM"}],["$","h2",null,{"children":"검증부터 예측 제출까지 연결하기"}],["$","p",null,{"children":"데이터 형태를 먼저 선택하고, loss·모델 선택 지표·제출 형식을 따로 설정하세요."}]]}]
c:["$","div",null,{"className":"playbook-grid","children":[["$","a","06",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/06/","children":[["$","span",null,{"className":"playbook-number","children":"06"}],["$","h3",null,{"children":"표형 회귀·다중 target·RMSLE"}],["$","p",null,{"children":"연속 정답 1개면 task=\"regression\", MLP(n_features=F,out_dim=1)입니다. target K개면 out_dim=K, y와 output 모두 [B,K]입니다. MODEL_KIND=\"mlp\"가 표형 출발점입니다. [N,F]에 CNN1D를 바로 연결하면 차원 오류가 납니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","07",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/07/","children":[["$","span",null,{"className":"playbook-number","children":"07"}],["$","h3",null,{"children":"이진분류·불균형·확률 제출"}],["$","p",null,{"children":"정상/고장처럼 두 class입니다. MLP(n_features=F,out_dim=1), task=\"binary\", y=[B,1] float 0/1, loss=BCEWithLogitsLoss. 모델 마지막에 sigmoid를 넣지 않습니다. 실행은 python pytorch-problem-starter.py --case binary입니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","08",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/08/","children":[["$","span",null,{"className":"playbook-number","children":"08"}],["$","h3",null,{"children":"다중분류와 multilabel 구분"}],["$","p",null,{"children":"한 샘플의 정답이 정확히 하나인가요? 그렇다면 multiclass입니다. 여러 고장 종류가 동시에 참일 수 있으면 multilabel입니다. 연속값 열이 여러 개인 경우는 둘 다 아니라 다중회귀입니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","09",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/09/","children":[["$","span",null,{"className":"playbook-number","children":"09"}],["$","h3",null,{"children":"이미 만들어진 시계열 window"}],["$","p",null,{"children":"처음 받은 X가 [N,L,F]이면 N개의 sample window가 이미 있습니다. window를 다시 만들지 않습니다. CNN1D(n_features=F,out_dim=K)가 첫 후보이며 내부에서 [B,L,F]→[B,F,L]로 바꿉니다. 외부에서 한 번 더 transpose하지 마세요."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","10",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/10/","children":[["$","span",null,{"className":"playbook-number","children":"10"}],["$","h3",null,{"children":"raw 시계열에서 미래 한 시점 예측"}],["$","p",null,{"children":"입력이 [T,F]이고 “과거 L개로 마지막 관측 H칸 뒤를 예측”한다면 make_point_forecast_windows를 씁니다. 마지막 관측 e의 입력은 X[e−L+1:e+1], 정답은 y[e+H]입니다. H=1은 다음 행입니다. 초와 sample 수를 혼동하지 말고 sampling rate와 실제 시간 간격을 확인하세요."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","11",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/11/","children":[["$","span",null,{"className":"playbook-number","children":"11"}],["$","h3",null,{"children":"이미지 분류·회귀"}],["$","p",null,{"children":"배열이면 prepare_numpy_images → SmallImageCNN(in_channels=C,out_dim=D) → 공통 학습입니다. 실행은 --case image. 파일 경로 목록이면 긴 치트시트 13절의 ImagePathDataset 경로를 별도 예제 계열로 선택하거나 이미지 통합 모의를 사용하세요. 경로 문자열을 make_tensor_loader에 넣지 않습니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}],["$","a","12",{"className":"playbook-card","href":"/hdat-ds-study-hub/playbook/12/","children":[["$","span",null,{"className":"playbook-number","children":"12"}],["$","h3",null,{"children":"정상-only Autoencoder 이상 탐지"}],["$","p",null,{"children":"정상 데이터만으로 학습해서 샘플별 이상 정도를 구하는 문제입니다. 표형은 Autoencoder(input_dim=F,latent_dim=...,hidden_dim=...), 입력 X 자체를 정답으로 주는 회귀 학습입니다. 실행은 --case anomaly. 이미지에는 full-mock-image-ae.py의 ConvAutoencoder와 reconstruction_errors를 선택합니다. 표형 AE에 4D 배열을 그대로 넣지 않습니다."}],["$","strong",null,{"children":"수정 지점과 검증 보기 →"}]]}]]}]
d:["$","section",null,{"className":"playbook-downloads","aria-labelledby":"playbook-download-title","children":[["$","h2",null,{"id":"playbook-download-title","children":"인터넷 없이 연습할 때"}],["$","p",null,{"children":"유형별 설명과 실행 파일을 함께 저장하세요. 딥러닝은 PyTorch이며, 합성 예제는 공식 기출을 복제하지 않았습니다."}],["$","div",null,{"className":"playbook-actions","children":[["$","a",null,{"className":"button button-primary","href":"/hdat-ds-study-hub/downloads/hdat-ds-study-pack.zip","download":true,"children":"전체 학습 팩 ZIP ↓"}],["$","a",null,{"className":"button button-light","href":"/hdat-ds-study-hub/downloads/hdat_templates.py","download":true,"children":"모델·함수 소스 ↓"}],["$","a",null,{"className":"button button-light","href":"/hdat-ds-study-hub/downloads/pytorch-problem-starter.py","download":true,"children":"8가지 합성 실행 예제 ↓"}],["$","a",null,{"href":"/hdat-ds-study-hub/downloads/hdat-ds-playbook.html","children":"유형별 가이드 단일 HTML ↗"}]]}]]}]
