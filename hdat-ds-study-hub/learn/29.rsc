,"li","15",{"data-current":false,"children":["$","a",null,{"href":"/hdat-ds-study-hub/learn/15/","children":["15",". ","Regularization·Hyperparameter Tuning·실험 설계"]}]}],["$","li","16",{"data-current":false,"children":["$","a",null,{"href":"/hdat-ds-study-hub/learn/16/","children":["16",". ","PyTorch 기초: Tensor·autograd·Dataset·DataLoader"]}]}],["$","li","17",{"data-current":false,"children":["$","a",null,{"href":"/hdat-ds-study-hub/learn/17/","children":["17",". ","퍼셉트론·MLP·활성함수·손실함수"]}]}],["$","li","18",{"data-current":false,"children":["$","a",null,{"href":"/hdat-ds-study-hub/learn/18/","children":["18",". ","PyTorch 학습 엔지니어링: optimizer·초기화·BN·Dropout"]}]}],["$","li","19",{"data-current":false,"children":["$","a",null,{"href":"/hdat-ds-study-hub/learn/19/","children":["19",". ","CNN: convolution·padding·pooling·이미지 코드"]}]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26"]}]]}],"$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f"]}]}]
