a",null,{"href":"#294-trainvalid-transform","children":"train/valid transform"}]}],["$","li","295",{"children":["$","a",null,{"href":"#295","children":"이미지 회귀"}]}],["$","li","296-convolutional-ae",{"children":["$","a",null,{"href":"#296-convolutional-ae","children":"convolutional AE"}]}],["$","li","297-threshold-validation",{"children":["$","a",null,{"href":"#297-threshold-validation","children":"threshold와 validation"}]}],["$","li","298",{"children":["$","a",null,{"href":"#298","children":"원본 모의문제 설계"}]}],["$","li","299",{"children":["$","a",null,{"href":"#299","children":"실습문제"}]}],["$","li","2910",{"children":["$","a",null,{"href":"#2910","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-29-7",{"children":["$","a",null,{"href":"#visual-29-7","children":"스스로 확인하기"}]}],["$","li","visual-29-8",{"children":["$","a",null,{"href":"#visual-29-8","children":"정답과 이유"}]}],["$","li","visual-29-9",{"children":["$","a",null,{"href":"#visual-29-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
