2c:["$","nav",null,{"className":"lesson-pager","aria-label":"이전 및 다음 강의","children":[["$","a",null,{"href":"/hdat-ds-study-hub/learn/31/","children":[["$","span",null,{"children":"이전 강의"}],["$","strong",null,{"children":["← ",31,". ","필기 모의고사 1회 — 20문항 50분"]}]]}],["$","a",null,{"className":"next","href":"/hdat-ds-study-hub/learn/33/","children":[["$","span",null,{"children":"다음 강의"}],["$","strong",null,{"children":[33,". ","Problem형 완전 모의 — 차량 센서 다중출력 예측"," →"]}]]}]]}]
