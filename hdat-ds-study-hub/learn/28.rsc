e",{"children":["$","a",null,{"href":"#284-flatten-baseline","children":"입력을 펼쳐 기준 모델 만들기"}]}],["$","li","285-cnn1d-first",{"children":["$","a",null,{"href":"#285-cnn1d-first","children":"CNN1D부터 비교하기"}]}],["$","li","286-gru-second",{"children":["$","a",null,{"href":"#286-gru-second","children":"시간이 남으면 GRU 비교하기"}]}],["$","li","288-test-window",{"children":["$","a",null,{"href":"#288-test-window","children":"test window 대응"}]}],["$","li","289-oom",{"children":["$","a",null,{"href":"#289-oom","children":"OOM 축소 순서"}]}],["$","li","2810",{"children":["$","a",null,{"href":"#2810","children":"원본 모의 문제"}]}],["$","li","2811",{"children":["$","a",null,{"href":"#2811","children":"실습문제"}]}],["$","li","2812",{"children":["$","a",null,{"href":"#2812","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-28-7",{"children":["$","a",null,{"href":"#visual-28-7","children":"스스로 확인하기"}]}],["$","li","visual-28-8",{"children":["$","a",null,{"href":"#visual-28-8","children":"정답과 이유"}]}],["$","li","visual-28-9",{"children":["$","a",null,{"href":"#visual-28-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
