29:["$","section",null,{"className":"outcome-card","aria-labelledby":"outcome-title","children":[["$","p",null,{"className":"micro-label","children":"AFTER THIS LESSON"}],["$","h2",null,{"id":"outcome-title","children":"이번 강의가 끝나면"}],["$","ul",null,{"children":[["$","li","대규모 다중출력 시계열 회귀를 시간·메모리 안에 완주한다.",{"children":[["$","span",null,{"aria-hidden":"true","children":"✓"}],"대규모 다중출력 시계열 회귀를 시간·메모리 안에 완주한다."]}],["$","li","naive/flatten/MLP/CNN1D/GRU 순으로 모델을 확장한다.",{"children":[["$","span",null,{"aria-hidden":"true","children":"✓"}],"naive/flatten/MLP/CNN1D/GRU 순으로 모델을 확장한다."]}],["$","li","target-index validation과 test 순서를 지킨다.",{"children":[["$","span",null,{"aria-hidden":"true","children":"✓"}],"target-index validation과 test 순서를 지킨다."]}],["$","li","(N_test,D) NPY를 안전하게 생성한다.",{"children":[["$","span",null,{"aria-hidden":"true","children":"✓"}],"(N_test,D) NPY를 안전하게 생성한다."]}]]}]]}]
