","a",null,{"href":"#164-device","children":"device"}]}],["$","li","165-autograd-graph",{"children":["$","a",null,{"href":"#165-autograd-graph","children":"autograd graph"}]}],["$","li","166-dataset",{"children":["$","a",null,{"href":"#166-dataset","children":"Dataset"}]}],["$","li","167-dataloader",{"children":["$","a",null,{"href":"#167-dataloader","children":"DataLoader"}]}],["$","li","168-dummy-forward",{"children":["$","a",null,{"href":"#168-dummy-forward","children":"dummy forward 계약 검사"}]}],["$","li","169",{"children":["$","a",null,{"href":"#169","children":"실습문제"}]}],["$","li","1610",{"children":["$","a",null,{"href":"#1610","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-16-7",{"children":["$","a",null,{"href":"#visual-16-7","children":"스스로 확인하기"}]}],["$","li","visual-16-8",{"children":["$","a",null,{"href":"#visual-16-8","children":"정답과 이유"}]}],["$","li","visual-16-9",{"children":["$","a",null,{"href":"#visual-16-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
