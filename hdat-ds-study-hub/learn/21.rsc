dren":["$","a",null,{"href":"#214-window","children":"작은 데이터에서 입력 구간 만들기"}]}],["$","li","215-group-safe-window",{"children":["$","a",null,{"href":"#215-group-safe-window","children":"그룹을 넘지 않는 입력 구간"}]}],["$","li","217-sequence-scaling",{"children":["$","a",null,{"href":"#217-sequence-scaling","children":"시퀀스 스케일링"}]}],["$","li","218-lazy-dataset",{"children":["$","a",null,{"href":"#218-lazy-dataset","children":"지연 로딩 Dataset"}]}],["$","li","219",{"children":["$","a",null,{"href":"#219","children":"실습문제"}]}],["$","li","2110",{"children":["$","a",null,{"href":"#2110","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-21-7",{"children":["$","a",null,{"href":"#visual-21-7","children":"스스로 확인하기"}]}],["$","li","visual-21-8",{"children":["$","a",null,{"href":"#visual-21-8","children":"정답과 이유"}]}],["$","li","visual-21-9",{"children":["$","a",null,{"href":"#visual-21-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
