],["$","li","36",{"children":["$","a",null,{"href":"#36","children":"시간 정렬"}]}],["$","li","37",{"children":["$","a",null,{"href":"#37","children":"메모리 감각"}]}],["$","li","38",{"children":["$","a",null,{"href":"#38","children":"미니 실습: 안전한 계약 검사기"}]}],["$","li","39",{"children":["$","a",null,{"href":"#39","children":"실습문제"}]}],["$","li","310",{"children":["$","a",null,{"href":"#310","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-03-7",{"children":["$","a",null,{"href":"#visual-03-7","children":"스스로 확인하기"}]}],["$","li","visual-03-8",{"children":["$","a",null,{"href":"#visual-03-8","children":"정답과 이유"}]}],["$","li","visual-03-9",{"children":["$","a",null,{"href":"#visual-03-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
