4-stable-softmax",{"children":["$","a",null,{"href":"#264-stable-softmax","children":"수치 함수: stable softmax"}]}],["$","li","265-standardization",{"children":["$","a",null,{"href":"#265-standardization","children":"선택 열 standardization"}]}],["$","li","266-iqr-flagclip",{"children":["$","a",null,{"href":"#266-iqr-flagclip","children":"IQR flag/clip"}]}],["$","li","267-pil-croplayout",{"children":["$","a",null,{"href":"#267-pil-croplayout","children":"PIL crop·layout"}]}],["$","li","268-cnn",{"children":["$","a",null,{"href":"#268-cnn","children":"정확한 CNN 명세 옮기기"}]}],["$","li","269-parametershape-quick-table",{"children":["$","a",null,{"href":"#269-parametershape-quick-table","children":"parameter·shape quick table"}]}],["$","li","2610-splitter",{"children":["$","a",null,{"href":"#2610-splitter","children":"splitter 선택·코드"}]}],["$","li","2611-feature-selectionextraction",{"children":["$","a",null,{"href":"#2611-feature-selectionextraction","children":"feature selection/extraction 최소 코드"}]}],["$","li","2612-process",{"children":["$","a",null,{"href":"#2612-process","children":"Process 시간 운영"}]}],["$","li","2613",{"children":["$","a",null,{"href":"#2613","children":"실습문제"}]}],["$","li","2614",{"children":["$","a",null,{"href":"#2614","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-26-7",{"children":["$","a",null,{"href":"#visual-26-7","children":"스스로 확인하기"}]}],["$","li","visual-26-8",{"children":["$","a",null,{"href":"#visual-26-8","children":"정답과 이유"}]}],["$","li","visual-26-9",{"children":["$","a",null,{"href":"#visual-26-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
