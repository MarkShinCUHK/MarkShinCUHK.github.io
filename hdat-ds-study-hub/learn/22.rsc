:"#224-gru","children":"GRU"}]}],["$","li","225-pytorch-sequence-model",{"children":["$","a",null,{"href":"#225-pytorch-sequence-model","children":"PyTorch sequence model"}]}],["$","li","226-bidirectional",{"children":["$","a",null,{"href":"#226-bidirectional","children":"bidirectional 함정"}]}],["$","li","227-cnn1d",{"children":["$","a",null,{"href":"#227-cnn1d","children":"CNN1D"}]}],["$","li","228-variable-length-mask",{"children":["$","a",null,{"href":"#228-variable-length-mask","children":"variable length와 mask"}]}],["$","li","229",{"children":["$","a",null,{"href":"#229","children":"실습문제"}]}],["$","li","2210",{"children":["$","a",null,{"href":"#2210","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-22-7",{"children":["$","a",null,{"href":"#visual-22-7","children":"스스로 확인하기"}]}],["$","li","visual-22-8",{"children":["$","a",null,{"href":"#visual-22-8","children":"정답과 이유"}]}],["$","li","visual-22-9",{"children":["$","a",null,{"href":"#visual-22-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
