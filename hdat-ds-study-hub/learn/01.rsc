","a",null,{"href":"#15-170","children":"170분 기본 운영안"}]}],["$","li","16",{"children":["$","a",null,{"href":"#16","children":"확인문제"}]}],["$","li","17",{"children":["$","a",null,{"href":"#17","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-01-7",{"children":["$","a",null,{"href":"#visual-01-7","children":"스스로 확인하기"}]}],["$","li","visual-01-8",{"children":["$","a",null,{"href":"#visual-01-8","children":"정답과 이유"}]}],["$","li","visual-01-9",{"children":["$","a",null,{"href":"#visual-01-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
