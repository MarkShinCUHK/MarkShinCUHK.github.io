24:["$","details",null,{"className":"mobile-lesson-toc","children":[["$","summary",null,{"children":["이번 강의 목차 ",["$","span",null,{"children":[22,"개"]}]]}],[["$","p",null,{"className":"toc-group-label","children":"그림으로 처음 배우기"}],["$","ol",null,{"children":[["$","li","visual-20-1",{"children":["$","a",null,{"href":"#visual-20-1","children":"먼저 떠올릴 장면"}]}],["$","li","visual-20-2",{"children":["$","a",null,{"href":"#visual-20-2","children":"낯선 말부터 풀기"}]}],["$","li","visual-20-3",{"children":["$","a",null,{"href":"#visual-20-3","children":"그림을 읽는 순서"}]}],["$","li","visual-20-4",{"children":["$","a",null,{"href":"#visual-20-4","children":"숫자로 끝까지 따라가기"}]}],["$","li","visual-20-5",{"children":["$","a",null,{"href":"#visual-20-5","children":"시험 문제로 연결하기"}]}],["$","li","visual-20-6",{"children":["$","a",null,{"href":"#visual-20-6","children":"자주 헷갈리는 지점"}]}]]}],["$","p",null,{"className":"toc-group-label","children":["$","a",null,{"href":"#theory-20","children":"필기 이론: 정의에서 풀이까지"}]}],["$","ol",null,{"children":[["$","li","theory-20-1",{"children":["$","a",null,{"href":"#theory-20-1","children":"잔차는 정답과 예측의 오차라는 뜻만 있는 것이 아니다"}]}],["$","li","theory-20-2",{"children":["$","a",null,{"href":"#theory-20-2","children":"덧셈·이어 붙이기·투영은 서로 다른 연산이다"}]}],["$","li","theory-20-3",{"children":["$","a",null,{"href":"#theory-20-3","children":"사전학습 백본과 새 헤드의 입력·출력을 맞춘다"}]}],["$","li","theory-20-4",{"children":["$","a",null,{"href":"#theory-20-4","children":"동결·평가 모드·옵티마이저의 갱신 대상을 각각 판단한다"}]}],["$","li","theory-20-5",{"children":["$","a",null,{"href":"#theory-20-5","children":"흑백 입력·정규화·데이터 분야의 차이를 처리한다"}]}]]}],["$","p",null,{"className":"toc-group-label","children":["$","a",null,{"href":"#lesson-deeper","children":"수식·코드·실전 확장"}]}],["$","ol",null,{"children":[["$","li","202-residual-learning",{"children":["$","a",null,{"href":"#202-residual-learning","children":"잔차 학습"}]}],["$","li","203-shape",{"children":["$","a",null,{"href":"#203-shape","children":"형태를 맞추는 조건"}]}],["$","li","204",{"children":["$","a",null,{"href":"#204","children":"전이학습"}]}],["$","li","205-normalize",{"children":["$","a",null,{"href":"#205-normalize","children":"입력 정규화"}]}],["$","li","206-freeze-batchnorm",{"children":["$","a",null,{"href":"#206-freeze-batchnorm","children":"파라미터 동결과 배치 정규화"}]}],["$","li","207-scratch",{"children":["$","a",null,{"href":"#207-scratch","children":"언제 처음부터 학습할까"}]}],["$","li","208",{"children":["$","a",null,{"href":"#208","children":"실습문제"}]}],["$","li","209",{"children":["$","a",null,{"href":"#209","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-20-7",{"children":["$","a",null,{"href":"#visual-20-7","children":"스스로 확인하기"}]}],["$","li","visual-20-8",{"children":["$","a",null,{"href":"#visual-20-8","children":"정답과 이유"}]}],["$","li","visual-20-9",{"children":["$","a",null,{"href":"#visual-20-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
