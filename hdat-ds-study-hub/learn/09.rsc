 계열"}]}],["$","li","94-pca",{"children":["$","a",null,{"href":"#94-pca","children":"PCA 상세"}]}],["$","li","95-lda",{"children":["$","a",null,{"href":"#95-lda","children":"LDA 차원축소"}]}],["$","li","96-leakage-safe",{"children":["$","a",null,{"href":"#96-leakage-safe","children":"데이터 누수 없는 파생변수"}]}],["$","li","97",{"children":["$","a",null,{"href":"#97","children":"실습문제"}]}],["$","li","98",{"children":["$","a",null,{"href":"#98","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-09-7",{"children":["$","a",null,{"href":"#visual-09-7","children":"스스로 확인하기"}]}],["$","li","visual-09-8",{"children":["$","a",null,{"href":"#visual-09-8","children":"정답과 이유"}]}],["$","li","visual-09-9",{"children":["$","a",null,{"href":"#visual-09-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
