n","children":"KNN"}]}],["$","li","105-distance",{"children":["$","a",null,{"href":"#105-distance","children":"distance"}]}],["$","li","106-pytorch",{"children":["$","a",null,{"href":"#106-pytorch","children":"PyTorch 최소 구현"}]}],["$","li","107",{"children":["$","a",null,{"href":"#107","children":"실습문제"}]}],["$","li","108",{"children":["$","a",null,{"href":"#108","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-10-7",{"children":["$","a",null,{"href":"#visual-10-7","children":"스스로 확인하기"}]}],["$","li","visual-10-8",{"children":["$","a",null,{"href":"#visual-10-8","children":"정답과 이유"}]}],["$","li","visual-10-9",{"children":["$","a",null,{"href":"#visual-10-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
