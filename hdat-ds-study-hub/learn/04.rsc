n":["$","a",null,{"href":"#43","children":"내적과 유사도"}]}],["$","li","44-norm",{"children":["$","a",null,{"href":"#44-norm","children":"norm과 정규화"}]}],["$","li","45-rank",{"children":["$","a",null,{"href":"#45-rank","children":"rank와 선형 종속"}]}],["$","li","46-pca",{"children":["$","a",null,{"href":"#46-pca","children":"고유값·고유벡터와 PCA"}]}],["$","li","47",{"children":["$","a",null,{"href":"#47","children":"손계산 예제"}]}],["$","li","48-pytorch",{"children":["$","a",null,{"href":"#48-pytorch","children":"PyTorch로 검산"}]}],["$","li","49",{"children":["$","a",null,{"href":"#49","children":"실습문제"}]}],["$","li","410",{"children":["$","a",null,{"href":"#410","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-04-7",{"children":["$","a",null,{"href":"#visual-04-7","children":"스스로 확인하기"}]}],["$","li","visual-04-8",{"children":["$","a",null,{"href":"#visual-04-8","children":"정답과 이유"}]}],["$","li","visual-04-9",{"children":["$","a",null,{"href":"#visual-04-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
