ial.html","target":"_blank","rel":"noreferrer noopener","children":[["$","span",null,{"children":"PyTorch 공식"}],["$","strong",null,{"children":"Save and load a model"}],["$","p",null,{"children":"state_dict 저장·reload와 eval 전환을 제출 전 검증 습관에 연결합니다."}],["$","small",null,{"children":"공식 페이지 열기 ↗"}]]}]]}]]}]
