,{"children":["$","a",null,{"href":"#184-optimizer","children":"optimizer"}]}],["$","li","185",{"children":["$","a",null,{"href":"#185","children":"초기화"}]}],["$","li","186-batch-normalization",{"children":["$","a",null,{"href":"#186-batch-normalization","children":"Batch Normalization"}]}],["$","li","187-dropout",{"children":["$","a",null,{"href":"#187-dropout","children":"Dropout"}]}],["$","li","188-early-stopping-checkpoint",{"children":["$","a",null,{"href":"#188-early-stopping-checkpoint","children":"early stopping과 checkpoint"}]}],["$","li","189-scheduler-gradient-clipping",{"children":["$","a",null,{"href":"#189-scheduler-gradient-clipping","children":"scheduler와 gradient clipping"}]}],["$","li","1810",{"children":["$","a",null,{"href":"#1810","children":"실습문제"}]}],["$","li","1811",{"children":["$","a",null,{"href":"#1811","children":"완료 기준"}]}]]}],["$","p",null,{"className":"toc-group-label","children":"기초 확인과 해설"}],["$","ol",null,{"children":[["$","li","visual-18-7",{"children":["$","a",null,{"href":"#visual-18-7","children":"스스로 확인하기"}]}],["$","li","visual-18-8",{"children":["$","a",null,{"href":"#visual-18-8","children":"정답과 이유"}]}],["$","li","visual-18-9",{"children":["$","a",null,{"href":"#visual-18-9","children":"더 읽을 공식 자료"}]}]]}]]]}]
